# Required: base domain for tunnel subdomains
MCPR_RELAY_DOMAIN=tunnel.example.com

# Optional: port (default 8080)
MCPR_RELAY_PORT=8080

# Auth mode: "open" (anyone can tunnel), "static" (token list), or "provider" (external API)
MCPR_RELAY_AUTH_MODE=open

# Required when MCPR_RELAY_AUTH_MODE=static:
# MCPR_RELAY_TOKENS=[{"token":"tok_abc","subdomains":["myapp","myapp-*"]}]

# Required when MCPR_RELAY_AUTH_MODE=provider:
# MCPR_RELAY_AUTH_URL=https://api.mcpr.app
# MCPR_RELAY_AUTH_SECRET=change-me-to-a-random-secret

# Optional body size limits in bytes (defaults: 5 MB request, 10 MB response)
# MCPR_RELAY_MAX_REQUEST_BODY=5242880
# MCPR_RELAY_MAX_RESPONSE_BODY=10485760
